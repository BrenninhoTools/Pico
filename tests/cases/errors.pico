try {
  let x = 1 / 0
} catch e {
  print("caught:", e)
}

try {
  throw "custom"
} catch e {
  print("caught:", e)
}

try {
  throw {code: 42}
} catch e {
  print(e.code)
}

try {
  undefinedName + 1
} catch e {
