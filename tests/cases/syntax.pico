let name = "Pico"
let n = 3
print("Hello, {name}! {n} + {n} = {n + n}")
print("nested: {"a" + "b"} {[1, 2].len()} \{escaped}")
print("map: {{k: 1}.k}")

fn greet(who, greeting = "Hello", punct = "!") {
  return "{greeting}, {who}{punct}"
}
print(greet("Ada"), greet("Bob", "Hi"), greet("Cy", "Yo", "?"))

fn total(first, ...rest) {
  return first + sum(rest)
}
print(total(1), total(1, 2, 3, 4))

fn show3(a, b, c) {
  return [a, b, c]
}
let parts = [2, 3]
print(show3(1, ...parts), [0, ...parts, 4, ...[5]])

for i in 0..3 {
  write(i, "")
}
print("")
for i in 1..=3 {
  write(i, "")
}
print("")
for i, v in 5..8 {
  write(i, ":", v, " ")
}
print("")
print(0..4, 2..=4, 3..3, 5..2)

let a = 7
print(a > 5 ? "big" : "small", a > 9 ? "big" : a > 6 ? "mid" : "small")

fn inc(x, by = 1) {
  return x + by
}
fn dbl(x) {
  return x * 2
}
print(3 |> inc |> dbl, 3 |> inc(10) |> dbl)
print(range(5) |> filter(fn(x) { return x % 2 == 0 }) |> map(str))

print("hello".upper(), "  pad ".trim().len(), "a,b".split(",").len())
print([3, 1, 2].sort().reverse(), [1, 2, 3].map(fn(x) { return x * x }).sum())
print({a: 1, b: 2}.keys(), {a: 1}.len(), 5.str() + "!")
print([1, [2, 3], [4]].flat(), [1, 2, 2, 3, 1].unique(), [4, 5].zip(["a", "b"]))
print([1, 2, 3].any(fn(x) { return x > 2 }), [1, 2, 3].all(fn(x) { return x > 2 }), [1, 2, 3].find(fn(x) { return x > 1 }))
print([1, 2, 3].first(), [1, 2, 3].last(), [5, 6, 7].index_of(7), [1, 2].join("-"))
print(entries({a: 1}), from_entries([["x", 1], ["y", 2]]), copy([1, 2]))
