use math
use text
use json
use time as clock

print(math.sqrt(16), math.floor(2.7), math.ceil(2.1), math.max(1, 9, 4), math.min(3, 2))
print(text.upper("pico"), text.trim("  x  "), text.split("a,b,c", ","))
print(text.replace("a-b-c", "-", "+"), text.starts("pico", "pi"), text.find("hello", "ll"))
print(text.join(["x", "y", 3], "|"))

let data = {name: "Pico", tags: ["a", "b"], n: 1.5, ok: true, none: nil}
let encoded = json.encode(data)
print(encoded)
print(json.decode(encoded) == data)

let list = [3, 1, 2]
push(list, 0)
print(list, pop(list), list)
print(sort(list), sort(list, fn(a, b) { return b - a }), reverse(list))
print(slice([1, 2, 3, 4], 1, 3), slice("hello", 1))
print(has([1, 2], 2), has({a: 1}, "a"), has("hello", "ell"), has([1], 5))
print(keys({a: 1, b: 2}), values({a: 1, b: 2}))
print(range(3), range(2, 5), range(10, 0, -4))
print(num("12.5"), num("abc"), str(12) + "!")
print(clock.now() > 0)
