fn fact(n) {
  if n <= 1 {
    return 1
  }
  return n * fact(n - 1)
}
print(fact(10))

fn adder(n) {
  return fn(x) {
    return x + n
  }
}
let add5 = adder(5)
print(add5(10))

let counter = 0
fn bump() {
  counter += 1
}
bump()
bump()
print(counter)

let shadow = 1
{
  let shadow = 2
  print(shadow)
}
print(shadow)
print(fn(a, b) { return a * b }(6, 7))
